#!/bin/bash
#SBATCH --account=iscrc_miosr
#SBATCH --partition=lrd_all_serial
#SBATCH --qos=normal
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=3G
#SBATCH --time=00:10:00
#SBATCH --no-requeue
#SBATCH --output=/leonardo_work/IscrC_MIOSR/lmolfett/mfa-moe/routing-study/results/measurement-study/logs/%x-%j.out
#SBATCH --error=/leonardo_work/IscrC_MIOSR/lmolfett/mfa-moe/routing-study/results/measurement-study/logs/%x-%j.err
set -euo pipefail
[[ -n "${SLURM_JOB_ID:-}" && "$(id -un)" == lmolfett ]] || exit 2
ROOT=/leonardo_work/IscrC_MIOSR/lmolfett/mfa-moe/routing-study
export PYTHONDONTWRITEBYTECODE=1
BUNDLE="${2:-$ROOT/results/measurement-study/recovery-sizing-code-v1}"
cd "$BUNDLE"
/usr/bin/python3.11 -B -m measurement_study.recovery_sizing "${1:?Source required}"
